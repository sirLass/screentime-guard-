{
  "name": "screentime-guard",
  "version": "0.0.1",
  "private": true,
  "description": "Open source, privacy-first screen-time tracker and site limiter for families.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @screentime-guard/extension dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,js,mjs,cjs}": "eslint --fix",
    "*.{ts,tsx,mts,js,mjs,cjs,json,jsonc,md,yml,yaml,css,html}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0"
  }
}
